# ============================================
# EXAMPLE: MongoDB Atlas + Redis (Upstash)
# ============================================
# Copy these examples to your .env file and replace with your actual values

# ============================================
# MONGODB ATLAS EXAMPLE
# ============================================
# 
# Your connection string from MongoDB Atlas will look like this:
# MONGODB_URI=mongodb+srv://myuser:mypassword123@cluster0.ab1cd.mongodb.net/growthCraft?retryWrites=true&w=majority
#
# Breaking it down:
# - mongodb+srv://           <- Protocol (always this for Atlas)
# - myuser                   <- Your database username
# - mypassword123            <- Your database password
# - cluster0.ab1cd.mongodb.net <- Your cluster hostname
# - /growthCraft             <- Your database name
# - ?retryWrites=true&w=majority <- Connection options

MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/growthCraft?retryWrites=true&w=majority
MONGODB_TEST_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/growthCraft_test?retryWrites=true&w=majority

# ============================================
# REDIS (UPSTASH) EXAMPLE
# ============================================
#
# Your connection URL from Upstash will look like this:
# REDIS_URL=rediss://default:AZHgAAIjcDEyNjg4ZjU5ZjE5YjQ0YzQ5YTk5ZjE5YjQ0YzQ5YTk5@example-12345.upstash.io:6379
#
# Breaking it down:
# - rediss://                <- Protocol (note the double 's' for TLS)
# - default                  <- Username (usually 'default')
# - AZHg...                  <- Your Redis password (long string)
# - example-12345.upstash.io <- Your Upstash endpoint
# - :6379                    <- Port (usually 6379)

REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_ENDPOINT.upstash.io:6379
REDIS_PASSWORD=

# ============================================
# ALTERNATIVE: Local Development
# ============================================
# If you want to use local databases instead:
#
# MONGODB_URI=mongodb://localhost:27017/growthCraft
# REDIS_URL=redis://localhost:6379

# ============================================
# NOTES
# ============================================
# 1. Never commit this file with real credentials!
# 2. The .env file is in .gitignore for security
# 3. For production, use environment-specific values
# 4. Redis is optional - app will work without it
