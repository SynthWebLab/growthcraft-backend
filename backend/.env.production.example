# # Server Configuration
# NODE_ENV=production
# PORT=5001

# # Database Configuration
# MONGODB_URI=mongodb://your-production-db:27017/growthCraft

# # JWT Configuration
# JWT_SECRET=your-production-jwt-secret-min-32-chars
# JWT_REFRESH_SECRET=your-production-refresh-secret-min-32-chars
# JWT_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# # Token Rotation Configuration
# TOKEN_ROTATION_ENABLED=true
# TOKEN_REUSE_DETECTION=true
# AUTO_REFRESH_THRESHOLD=5m
# MAX_REFRESH_TOKENS_PER_USER=5

# # Redis Configuration
# REDIS_URL=redis://your-redis-host:6379
# REDIS_PASSWORD=your-redis-password

# # Email Configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# # Frontend URL
# FRONTEND_URL=https://your-production-domain.com

# # Rate Limiting
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# # Security
# BCRYPT_SALT_ROUNDS=12
# COOKIE_SECRET=your-production-cookie-secret-min-32-chars

# # Logging
# LOG_LEVEL=error

# # Swagger/API Documentation
# # IMPORTANT: Disable Swagger in production for security
# SWAGGER_ENABLED=false
# SWAGGER_PATH=/api-docs
# SWAGGER_AUTO_PATH=/api-docs-auto
