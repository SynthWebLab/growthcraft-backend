# # Server Configuration
# NODE_ENV=production
# PORT=5001

# # Database Configuration
# MONGODB_URI=mongodb://your-production-db:27017/growthCraft

# # JWT Configuration
# JWT_SECRET=your-production-jwt-secret-min-32-chars
# JWT_REFRESH_SECRET=your-production-refresh-secret-min-32-chars
# JWT_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# # Token Rotation Configuration
# TOKEN_ROTATION_ENABLED=true
# TOKEN_REUSE_DETECTION=true
# AUTO_REFRESH_THRESHOLD=5m
# MAX_REFRESH_TOKENS_PER_USER=5

# # Redis Configuration
# REDIS_URL=redis://your-redis-host:6379
# REDIS_PASSWORD=your-redis-password
# REDIS_MAX_RETRIES=12

# # Email Configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Frontend URL (required — controls CORS allowed origin and email links)
FRONTEND_URL=https://growthcraft.cloud
# Allowed Origins (optional — comma-separated for multiple domains, e.g. https://growthcraft.cloud,https://www.growthcraft.cloud)
ALLOWED_ORIGINS=https://growthcraft.cloud,https://www.growthcraft.cloud

# # Rate Limiting
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# # Security
# BCRYPT_SALT_ROUNDS=12
# COOKIE_SECRET=your-production-cookie-secret-min-32-chars

# # Logging
# LOG_LEVEL=error
# # File-based logging (rotating daily files). Enabled by default in production.
# LOG_TO_FILE=true
# LOG_DIR=logs
# LOG_MAX_SIZE=20m
# LOG_MAX_FILES=14d
# LOG_ZIP_ARCHIVE=true

# # Swagger/API Documentation
# # IMPORTANT: Swagger should remain disabled in production.
# # If explicitly enabled, authentication is mandatory to prevent exposing the API attack surface.
# SWAGGER_ENABLED=false
# SWAGGER_PATH=/api-docs
# SWAGGER_AUTO_PATH=/api-docs-auto
# SWAGGER_REQUIRE_AUTH=true
# SWAGGER_USER=growthcraft_admin
# SWAGGER_PASSWORD=change_this_to_a_strong_random_password_min_32_chars

