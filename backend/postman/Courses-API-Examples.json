{
  "info": {
    "name": "Courses API Examples",
    "description": "Example requests for the Courses API with filtering, search, and pagination",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get All Courses (Default)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{BASE_URL}}/api/v1/courses",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "v1", "courses"]
        }
      },
      "response": []
    },
    {
      "name": "Get Courses - Filter by Category (MERN)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{BASE_URL}}/api/v1/courses?category=MERN",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "v1", "courses"],
          "query": [
            {
              "key": "category",
              "value": "MERN"
            }
          ]
        }
      },
      "response": []
    },
