    {
      "name": "Get Courses - Complex Query",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{BASE_URL}}/api/v1/courses?category=MERN&difficultyLevel=Intermediate&minRating=4.5&sortBy=enrollmentCount&sortOrder=desc&page=1&limit=10",
