            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Sarah Johnson\",\n  \"email\": \"sarah.mentor@example.com\",\n  \"phone\": \"+91-98765-22222\",\n  \"password\": \"MentorPass123\",\n  \"role\": \"mentor\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        },
        "description": "Register a new mentor account"
      },
      "response": []
    },
    {
