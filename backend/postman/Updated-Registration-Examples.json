    },
    {
      "name": "6. Invalid Role (Should Fail)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"phone\": \"+91-98765-99999\",\n  \"password\": \"TestPass123\",\n  \"role\": \"ambassador\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        },
        "description": "Test with invalid role 'ambassador' - should return validation error"
      },
      "response": []
    },
    {
      "name": "7. College Missing Required Fields (Should Fail)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Dr. Test\",\n  \"email\": \"test@college.edu\",\n  \"phone\": \"+91-98765-88888\",\n  \"password\": \"TestPass123\",\n  \"role\": \"college\",\n  \"collegeData\": {\n    \"institutionName\": \"Test College\",\n    \"contactPerson\": \"Dr. Test\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        },
        "description": "Test college registration with missing required fields - should return validation error"
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ]
