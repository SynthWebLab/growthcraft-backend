        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Alice Brown\",\n  \"email\": \"alice.brown@example.com\",\n  \"phone\": \"+1234567894\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/events/Hackathon/{{eventId}}/request-callback",
          "host": ["{{baseUrl}}"],
          "path": ["events", "Hackathon", "{{eventId}}", "request-callback"]
