{
  "info": {
    "name": "Event Enrollment API",
    "description": "API collection for Event Enrollment (Bootcamps, Workshops, Hackathons)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "eventId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Register for Bootcamp",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"phone\": \"+1234567890\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/events/Bootcamp/{{eventId}}/register",
          "host": ["{{baseUrl}}"],
          "path": ["events", "Bootcamp", "{{eventId}}", "register"]
        },
        "description": "Register/Reserve seat for a bootcamp (requires authentication)"
      },
      "response": []
    },
    {
      "name": "2. Register for Workshop",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Jane Smith\",\n  \"email\": \"jane.smith@example.com\",\n  \"phone\": \"+1234567891\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/events/Workshop/{{eventId}}/register",
          "host": ["{{baseUrl}}"],
          "path": ["events", "Workshop", "{{eventId}}", "register"]
        },
        "description": "Register for a workshop (requires authentication)"
      },
      "response": []
    },
    {
      "name": "3. Register for Hackathon",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Bob Johnson\",\n  \"email\": \"bob.johnson@example.com\",\n  \"phone\": \"+1234567892\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/events/Hackathon/{{eventId}}/register",
          "host": ["{{baseUrl}}"],
          "path": ["events", "Hackathon", "{{eventId}}", "register"]
        },
        "description": "Register for a hackathon (requires authentication)"
      },
      "response": []
    },
    {
      "name": "4. Request Callback - Bootcamp (Authenticated)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"phone\": \"+1234567890\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/events/Bootcamp/{{eventId}}/request-callback",
          "host": ["{{baseUrl}}"],
          "path": ["events", "Bootcamp", "{{eventId}}", "request-callback"]
        },
        "description": "Request callback for a bootcamp (logged-in user)"
      },
      "response": []
    },
    {
      "name": "5. Request Callback - Workshop (Guest)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Guest User\",\n  \"email\": \"guest@example.com\",\n  \"phone\": \"+1234567893\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/events/Workshop/{{eventId}}/request-callback",
          "host": ["{{baseUrl}}"],
          "path": ["events", "Workshop", "{{eventId}}", "request-callback"]
        },
        "description": "Request callback for a workshop (guest user - no auth)"
      },
      "response": []
    },
    {
      "name": "6. Request Callback - Hackathon",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
