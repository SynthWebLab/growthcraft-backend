  },
  "item": [
    {
      "name": "Get All Courses",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5001/api/v1/courses",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": ["api", "v1", "courses"]
        },
        "description": "Get all courses with dynamic status computation"
      }
    },
    {
      "name": "Get All Courses (Paginated)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5001/api/v1/courses?page=1&limit=5",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": ["api", "v1", "courses"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "5"
            }
          ]
        },
        "description": "Get courses with pagination"
      }
    },
    {
