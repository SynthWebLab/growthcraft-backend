{
  "info": {
    "name": "College Registration Example",
    "description": "Example requests for college registration flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register College - Complete",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Dr. Sharma\",\n  \"email\": \"admin@abcollege.edu\",\n  \"phone\": \"+91-98765-12310\",\n  \"password\": \"SecurePass123\",\n  \"role\": \"college\",\n  \"collegeData\": {\n    \"institutionName\": \"ABC Engineering College\",\n    \"contactPerson\": \"Dr. Sharma\",\n    \"designation\": \"HOD / TPO\",\n    \"officialEmail\": \"admin@abcollege.edu\",\n    \"phone\": \"+91-98765-12310\",\n    \"city\": \"Guwahati\",\n    \"state\": \"Assam\",\n    \"website\": \"https://abcollege.edu\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        },
        "description": "Complete college registration with all required fields"
      },
      "response": []
    },
    {
