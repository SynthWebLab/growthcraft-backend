{
  "info": {
    "name": "Change Password API Examples",
    "description": "Collection of examples for testing the Change Password API (for authenticated users)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "1. Login to Get Tokens",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Save cookies for subsequent requests",
                  "pm.test(\"Login successful\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().success).to.be.true;",
                  "});",
                  "",
                  "// Cookies are automatically saved by Postman"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{current_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login first to get authentication cookies required for change password endpoint.\n\n**Prerequisites:**\n- User must be registered\n- Email must be verified\n\n**Expected Response:**\n- Status: 200 OK\n- Cookies: access_token and refreshToken set automatically"
          },
          "response": []
        }
      ],
      "description": "Setup requests to authenticate before testing change password"
    },
    {
      "name": "Change Password Tests",
      "item": [
        {
          "name": "2. Change Password - Valid Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Password changed successfully\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.true;",
                  "    pm.expect(response.message).to.equal('Password changed successfully');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{current_password}}\",\n  \"newPassword\": \"{{new_password}}\",\n  \"confirmPassword\": \"{{new_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/change-password",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "change-password"]
            },
            "description": "Change password with valid current password and new password.\n\n**Prerequisites:**\n- Must be logged in (run \"Login to Get Tokens\" first)\n- Current password must be correct\n\n**Expected Response:**\n- Status: 200 OK\n- Message: \"Password changed successfully\"\n\n**Note:** After this request succeeds, you'll need to login with the new password."
          },
          "response": [
            {
              "name": "Success Response",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"currentPassword\": \"CurrentPass123!\",\n  \"newPassword\": \"NewSecurePass123!\",\n  \"confirmPassword\": \"NewSecurePass123!\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/auth/change-password",
                  "host": ["{{base_url}}"],
                  "path": ["api", "auth", "change-password"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"Password changed successfully\"\n}"
            }
          ]
        },
        {
          "name": "3. Change Password - Incorrect Current Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Rejects incorrect current password\", function () {",
                  "    pm.response.to.have.status(400);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.false;",
                  "    pm.expect(response.error.message).to.equal('Current password is incorrect');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"WrongPassword123!\",\n  \"newPassword\": \"NewSecurePass123!\",\n  \"confirmPassword\": \"NewSecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/change-password",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "change-password"]
            },
            "description": "Attempt to change password with incorrect current password.\n\n**Expected Response:**\n- Status: 400 Bad Request\n- Error: \"Current password is incorrect\""
          },
          "response": [
            {
              "name": "Incorrect Password Error",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"currentPassword\": \"WrongPassword123!\",\n  \"newPassword\": \"NewSecurePass123!\",\n  \"confirmPassword\": \"NewSecurePass123!\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/auth/change-password",
                  "host": ["{{base_url}}"],
                  "path": ["api", "auth", "change-password"]
                }
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": false,\n  \"error\": {\n    \"message\": \"Current password is incorrect\",\n    \"code\": \"PASSWORD_CHANGE_FAILED\"\n  }\n}"
            }
          ]
        },
        {
          "name": "4. Change Password - Same as Current",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Rejects same password\", function () {",
                  "    pm.response.to.have.status(400);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.false;",
                  "    pm.expect(response.error.message).to.include('must be different');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{current_password}}\",\n  \"newPassword\": \"{{current_password}}\",\n  \"confirmPassword\": \"{{current_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/change-password",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "change-password"]
            },
            "description": "Attempt to change password to the same password.\n\n**Expected Response:**\n- Status: 400 Bad Request\n- Error: \"New password must be different from current password\""
          },
          "response": [
            {
              "name": "Same Password Error",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"currentPassword\": \"CurrentPass123!\",\n  \"newPassword\": \"CurrentPass123!\",\n  \"confirmPassword\": \"CurrentPass123!\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/auth/change-password",
                  "host": ["{{base_url}}"],
                  "path": ["api", "auth", "change-password"]
                }
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": false,\n  \"error\": {\n    \"message\": \"New password must be different from current password\",\n    \"code\": \"PASSWORD_CHANGE_FAILED\"\n  }\n}"
            }
          ]
        },
        {
          "name": "5. Change Password - Weak Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Rejects weak password\", function () {",
                  "    pm.response.to.have.status(400);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.false;",
                  "    pm.expect(response.error.code).to.equal('VALIDATION_ERROR');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{current_password}}\",\n  \"newPassword\": \"weak\",\n  \"confirmPassword\": \"weak\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/change-password",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "change-password"]
            },
            "description": "Attempt to change to a weak password that doesn't meet requirements.\n\n**Expected Response:**\n- Status: 400 Bad Request\n- Error: Validation error with password requirements"
          },
          "response": [
            {
              "name": "Weak Password Error",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"currentPassword\": \"CurrentPass123!\",\n  \"newPassword\": \"weak\",\n  \"confirmPassword\": \"weak\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/auth/change-password",
                  "host": ["{{base_url}}"],
                  "path": ["api", "auth", "change-password"]
                }
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": false,\n  \"error\": {\n    \"message\": \"Validation failed\",\n    \"code\": \"VALIDATION_ERROR\",\n    \"details\": [\n      {\n        \"msg\": \"Password must be at least 8 characters\",\n        \"param\": \"newPassword\",\n        \"location\": \"body\"\n      },\n      {\n        \"msg\": \"Password must contain at least one uppercase letter, one lowercase letter, and one number\",\n        \"param\": \"newPassword\",\n        \"location\": \"body\"\n      }\n    ]\n  }\n}"
            }
          ]
        },
        {
          "name": "6. Change Password - Password Mismatch",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Rejects password mismatch\", function () {",
                  "    pm.response.to.have.status(400);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.false;",
                  "    pm.expect(response.error.code).to.equal('VALIDATION_ERROR');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{current_password}}\",\n  \"newPassword\": \"NewSecurePass123!\",\n  \"confirmPassword\": \"DifferentPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/change-password",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "change-password"]
            },
            "description": "Attempt to change password with mismatched confirmation.\n\n**Expected Response:**\n- Status: 400 Bad Request\n- Error: \"Passwords do not match\""
          },
          "response": [
            {
              "name": "Password Mismatch Error",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"currentPassword\": \"CurrentPass123!\",\n  \"newPassword\": \"NewSecurePass123!\",\n  \"confirmPassword\": \"DifferentPass123!\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/auth/change-password",
                  "host": ["{{base_url}}"],
                  "path": ["api", "auth", "change-password"]
                }
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": false,\n  \"error\": {\n    \"message\": \"Validation failed\",\n    \"code\": \"VALIDATION_ERROR\",\n    \"details\": [\n      {\n        \"msg\": \"Passwords do not match\",\n        \"param\": \"confirmPassword\",\n        \"location\": \"body\"\n      }\n    ]\n  }\n}"
            }
          ]
        },
        {
          "name": "7. Change Password - Missing Fields",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Rejects missing fields\", function () {",
                  "    pm.response.to.have.status(400);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.false;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{current_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/change-password",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "change-password"]
            },
            "description": "Attempt to change password without providing new password.\n\n**Expected Response:**\n- Status: 400 Bad Request\n- Error: Missing required fields"
          },
          "response": []
        },
        {
          "name": "8. Change Password - Unauthenticated",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Clear cookies to simulate unauthenticated request",
                  "pm.cookies.clear();"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Rejects unauthenticated request\", function () {",
                  "    pm.response.to.have.status(401);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.false;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"CurrentPass123!\",\n  \"newPassword\": \"NewSecurePass123!\",\n  \"confirmPassword\": \"NewSecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/change-password",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "change-password"]
            },
            "description": "Attempt to change password without being logged in.\n\n**Expected Response:**\n- Status: 401 Unauthorized\n- Error: Authentication required\n\n**Note:** This request clears cookies before sending to simulate unauthenticated state."
          },
          "response": [
            {
              "name": "Unauthorized Error",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"currentPassword\": \"CurrentPass123!\",\n  \"newPassword\": \"NewSecurePass123!\",\n  \"confirmPassword\": \"NewSecurePass123!\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/auth/change-password",
                  "host": ["{{base_url}}"],
                  "path": ["api", "auth", "change-password"]
                }
              },
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": false,\n  \"error\": {\n    \"message\": \"Authentication required\",\n    \"code\": \"UNAUTHORIZED\"\n  }\n}"
            }
          ]
        }
      ],
      "description": "Test cases for change password functionality"
    },
    {
      "name": "Verification",
      "item": [
        {
          "name": "9. Login with New Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Can login with new password\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.true;",
                  "    pm.expect(response.message).to.equal('Login successful');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{new_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Verify that password change was successful by logging in with new password.\n\n**Prerequisites:**\n- Password must have been changed successfully\n\n**Expected Response:**\n- Status: 200 OK\n- Message: \"Login successful\""
          },
          "response": []
        }
      ],
      "description": "Verify password change was successful"
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "test_email",
      "value": "user@example.com",
      "type": "string"
    },
    {
      "key": "current_password",
      "value": "CurrentPass123!",
      "type": "string"
    },
    {
      "key": "new_password",
      "value": "NewSecurePass123!",
      "type": "string"
    }
  ]
}
