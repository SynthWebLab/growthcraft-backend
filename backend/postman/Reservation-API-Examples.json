              "port": "5001",
              "path": ["api", "v1", "bootcamps"],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Get bootcamp IDs to use in reservation tests. Copy an ID from the response."
