{
  "info": {
    "name": "GrowthCraft - Authentication APIs",
    "description": "Complete authentication flow with OTP-based email verification",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "growthcraft"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5001/api/v1",
      "type": "string"
    },
    {
      "key": "test_email",
      "value": "sandipan.goswami@synthweb.in",
      "type": "string"
    },
    {
      "key": "test_password",
      "value": "Test123!",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth Flow",
      "item": [
        {
          "name": "1. Register User (Sends OTP)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"User created successfully\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.user.isEmailVerified).to.eql(false);",
                  "    pm.expect(jsonData.data.requiresEmailVerification).to.eql(true);",
                  "});",
                  "",
                  "pm.test(\"Response contains user data\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.user).to.have.property('id');",
                  "    pm.expect(jsonData.data.user).to.have.property('email');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Sandipan Goswami\",\n  \"email\": \"{{test_email}}\",\n  \"phone\": \"+919876543210\",\n  \"password\": \"{{test_password}}\",\n  \"role\": \"student\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Register a new user. This will:\n- Create user account\n- Generate 6-digit OTP\n- Send OTP via email\n- Return user data with isEmailVerified=false\n\nCheck your email for the OTP!"
          },
          "response": []
        },
        {
          "name": "2. Login WITHOUT Verification (Should Fail)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "",
                  "pm.test(\"Login blocked for unverified email\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(false);",
                  "    pm.expect(jsonData.error.code).to.eql('EMAIL_NOT_VERIFIED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Attempt to login without email verification.\n\nExpected: 403 Forbidden\nError: EMAIL_NOT_VERIFIED\n\nThis proves that login is blocked until email is verified."
          },
          "response": []
        },
        {
          "name": "3. Verify Email with OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Email verified successfully\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.message).to.include('verified');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/verify-email",
              "host": ["{{base_url}}"],
              "path": ["auth", "verify-email"]
            },
            "description": "Verify email with OTP received in email.\n\n⚠️ IMPORTANT: Replace '123456' with the actual OTP from your email!\n\nAfter successful verification:\n- isEmailVerified will be set to true\n- Welcome email will be sent\n- User can now login"
          },
          "response": []
        },
        {
          "name": "4. Login AFTER Verification (Should Succeed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Login successful\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.user.isEmailVerified).to.eql(true);",
                  "});",
                  "",
                  "pm.test(\"Cookies are set\", function () {",
                  "    pm.expect(pm.cookies.has('access_token')).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Login after email verification.\n\nExpected: 200 OK\nResult: Login successful with tokens\n\nThis proves the complete flow works!"
          },
          "response": []
        },
        {
          "name": "5. Resend Verification OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 429\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 429]);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"OTP resent successfully\", function () {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData.success).to.eql(true);",
                  "    });",
                  "}",
                  "",
                  "if (pm.response.code === 429) {",
                  "    pm.test(\"Rate limit working\", function () {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData.error.code).to.eql('RATE_LIMIT_EXCEEDED');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/resend-verification",
              "host": ["{{base_url}}"],
              "path": ["auth", "resend-verification"]
            },
            "description": "Resend verification OTP if:\n- User didn't receive the email\n- OTP expired (10 minutes)\n- User exceeded max attempts (5)\n\nRate Limit: 2 minutes between requests"
          },
          "response": []
        }
      ],
      "description": "Complete authentication flow with email verification"
    },
    {
      "name": "Error Scenarios",
      "item": [
        {
          "name": "Invalid OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"otp\": \"000000\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/verify-email",
              "host": ["{{base_url}}"],
              "path": ["auth", "verify-email"]
            },
            "description": "Test with invalid OTP.\n\nExpected: 400 Bad Request\nMessage: \"Invalid OTP. You have X attempts remaining.\""
          },
          "response": []
        },
        {
          "name": "Invalid OTP Format",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"otp\": \"12345\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/verify-email",
              "host": ["{{base_url}}"],
              "path": ["auth", "verify-email"]
            },
            "description": "Test with invalid OTP format (not 6 digits).\n\nExpected: 400 Bad Request\nMessage: \"Invalid OTP format. OTP must be 6 digits.\""
          },
          "response": []
        },
        {
          "name": "Duplicate Registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Sandipan Goswami\",\n  \"email\": \"{{test_email}}\",\n  \"phone\": \"+919876543210\",\n  \"password\": \"{{test_password}}\",\n  \"role\": \"student\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Try to register with existing email.\n\nExpected: 409 Conflict\nMessage: \"User with this email already exists\""
          },
          "response": []
        }
      ],
      "description": "Test error handling scenarios"
    },
    {
      "name": "Other Auth Endpoints",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/profile",
              "host": ["{{base_url}}"],
              "path": ["auth", "profile"]
            },
            "description": "Get current user profile (requires authentication)"
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            },
            "description": "Logout from current session"
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["auth", "refresh"]
            },
            "description": "Refresh access token using refresh token"
          },
          "response": []
        }
      ],
      "description": "Other authentication endpoints"
    }
  ]
}
