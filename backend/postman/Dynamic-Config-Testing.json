    {
      "name": "Update Categories (Admin)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"values\": [\"MERN\", \"UI/UX\", \"DataScience\", \"DevOps\", \"Mobile\", \"Blockchain\"]\n}"
        },
        "url": {
          "raw": "http://localhost:5001/api/v1/courses/config/categories",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": ["api", "v1", "courses", "config", "categories"]
        },
        "description": "Update categories configuration (adds Mobile and Blockchain)"
      }
    },
