{
  "info": {
    "name": "Dynamic Config Testing",
    "description": "Test dynamic course configuration endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get All Configurations",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5001/api/v1/courses/config",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": ["api", "v1", "courses", "config"]
        },
        "description": "Get all dynamic configurations (categories, difficulty levels, course types)"
      }
    },
    {
