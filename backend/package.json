{
  "name": "growthcraft-backend",
  "version": "1.0.0",
  "description": "GrowthCraft EdTech SaaS Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "npm run swagger:auto && nodemon",
    "build": "npm run swagger:auto && tsc && tsc-alias",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:connections": "node scripts/test-connections.js",
    "test:email": "ts-node scripts/test-email.ts",
    "test:search": "ts-node scripts/test-search.ts",
    "seed:courses": "ts-node scripts/seed-courses.ts",
    "seed:bootcamps": "ts-node scripts/seed-bootcamps.ts",
    "init:config": "ts-node scripts/init-course-config.ts",
    "fix:enrollment": "ts-node scripts/fix-course-enrollment.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\"",
    "type-check": "tsc --noEmit",
    "verify-setup": "node scripts/verify-setup.js",
    "verify-jwt": "node scripts/verify-jwt-config.js",
    "swagger:generate": "node scripts/generate-swagger-template.js",
    "swagger:auto": "node scripts/swagger-autogen.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "nodemailer": "^8.0.5",
    "redis": "^4.6.11",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^8.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "swagger-autogen": "^2.23.7",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "edtech",
    "saas",
    "education",
    "api",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "GrowthCraft Team",
  "license": "MIT"
}
