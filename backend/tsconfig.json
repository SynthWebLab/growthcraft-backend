{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "node",
    "baseUrl": "./src",
    "typeRoots": ["./node_modules/@types", "./src/common/types"],
    "types": ["node", "jest"],
    "paths": {
      "@/*": ["*"],
      "@/common/*": ["common/*"],
      "@/modules/*": ["modules/*"],
      "@/config/*": ["config/*"],
      "@/database/*": ["database/*"]
    },
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*", "src/common/types/**/*.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "scripts",
    "scratch",
    "postman",
    "swagger-docs",
    "uploads",
    "src/test",
    "**/*.test.ts",
    "**/*.spec.ts"
  ],
  "files": ["src/common/types/express.d.ts"],
  "ts-node": {
    "require": ["tsconfig-paths/register"],
    "transpileOnly": true,
    "files": true
  }
}
